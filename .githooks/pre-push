#!/bin/sh
# Local publication, lint (with typecheck) and test checks; CI also builds.
# Text-only pushes run the publication check and the prose tests only.
set -eu
# Tests create scratch repositories. Do not pass this repository's hook env.
for variable in $(env | sed -n 's/^\(GIT_[A-Za-z0-9_]*\)=.*/\1/p'); do
  unset "$variable"
done
cd "$(git rev-parse --show-toplevel)"
scope="$(node scripts/change-scope.mjs --pre-push)"
node scripts/check-publication.mjs --history
if [ "$scope" = text ]; then
  node scripts/change-scope.mjs --run-text-tests
  exit 0
fi
pnpm run lint
pnpm run test
