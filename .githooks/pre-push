#!/bin/sh
# Local publication, lint, test and build checks supplement GitHub PR checks.
set -eu
# Tests create scratch repositories. Do not pass this repository's hook env.
for variable in $(env | sed -n 's/^\(GIT_[A-Za-z0-9_]*\)=.*/\1/p'); do
  unset "$variable"
done
cd "$(git rev-parse --show-toplevel)"
node scripts/check-publication.mjs --history
pnpm run lint
pnpm run test
pnpm run build
