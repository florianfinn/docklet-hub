{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // Type-check against the source of `contract`, the same files tsx loads
    // with `--conditions=source`. The build drops the condition again
    // (`tsconfig.build.json`).
    "customConditions": ["source"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}
