# Pin the image to the installed docklet hub release.
DOCKER_AGENT_IMAGE=ghcr.io/florianfinn/docklet-hub-agent:v0.32.0
DOCKER_AGENT_SECRET=<your-agent-secret-at-least-32-characters>
# Only during secret rotation: the OLD value. Both secrets are accepted until
# the main API has switched. Then remove this line and restart the agent.
# See "Rotating the secret" in the repository README.
# DOCKER_AGENT_SECRET_ALT=<previous-agent-secret>
DOCKER_AGENT_READ_ONLY=true
DOCKER_AGENT_HOST=10.253.0.3
DOCKER_AGENT_TUNNEL_CIDR=10.253.0.0/24
DOCKER_AGENT_BIND_BASE_PATH=/home/docker
DOCKER_GID=<docker-group-id-on-the-target-host>

# Backup directory: empty uses the backups subdirectory of the agent data directory.
# Contract setting; consumed by the backup implementation.
DOCKER_AGENT_BACKUP_DIR=
